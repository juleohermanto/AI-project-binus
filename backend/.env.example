# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Untuk `prisma migrate deploy`, gunakan host direct (tanpa "-pooler").
# Untuk runtime serverless, host "-pooler" dapat digunakan.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Authentication ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-64-character-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-character-hex-string"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ── Cookies ──────────────────────────────────────────────────────────────
# Development (localhost): COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production cross-site (e.g. Vercel + separate API domain): true / none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── AI (Google Gemini) ───────────────────────────────────────────────────
# Set AI_PROVIDER=mock to run without a Gemini API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=15000

# ── App ──────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Jakarta
